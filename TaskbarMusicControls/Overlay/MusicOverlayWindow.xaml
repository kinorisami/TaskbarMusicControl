<Window x:Class="TaskbarMusicControls.Overlay.MusicOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Taskbar colours. ApplyTheme() replaces these values when the taskbar
             switches between its light and dark appearance. -->
        <SolidColorBrush x:Key="TextPrimary" Color="#202124"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#50545A"/>
        <SolidColorBrush x:Key="IconForeground" Color="#30343A"/>
        <SolidColorBrush x:Key="Accent" Color="#167C69"/>
        <SolidColorBrush x:Key="HoverOverlay" Color="#18000000"/>
        <SolidColorBrush x:Key="PressedOverlay" Color="#28000000"/>
        <SolidColorBrush x:Key="PlayOverlay" Color="#22000000"/>
        <SolidColorBrush x:Key="PlayOverlayHover" Color="#44000000"/>
        <SolidColorBrush x:Key="PlayOverlayPressed" Color="#66000000"/>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource IconForeground}"/>
            <Setter Property="Background" Value="#01000000"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource HoverOverlay}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource PressedOverlay}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton"
               TargetType="Button"
               BasedOn="{StaticResource TransportButton}">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="HoverPlaybackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PlayOverlay}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource PlayOverlayHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource PlayOverlayPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0"
            MouseRightButtonUp="OnRootRightButtonUp"
            MouseWheel="OnRootMouseWheel">

        <Grid>
            <!-- Horizontal layout -->
            <Grid x:Name="HorizontalContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ArtworkColumn" Width="50"/>
                    <ColumnDefinition x:Name="MetadataColumn" Width="*"/>
                    <ColumnDefinition x:Name="ControlsColumn" Width="112"/>
                </Grid.ColumnDefinitions>

                <!-- Album artwork -->
                <Border x:Name="Artwork"
                        Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        MouseEnter="OnArtworkMouseEnter"
                        MouseLeave="OnArtworkMouseLeave"
                        MouseLeftButtonUp="OnArtworkMouseUp"
                        MouseDown="OnArtworkMouseDown">

                    <Border.Background>
                        <SolidColorBrush Color="#26353D"/>
                    </Border.Background>

                    <Grid>
                        <TextBlock x:Name="ArtworkGlyph"
                                   Text="♫"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="28"
                                   Foreground="#267D6C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Image x:Name="ArtworkImage"
                               Stretch="UniformToFill"
                               Visibility="Collapsed"/>

                        <Button x:Name="HoverPlaybackButton"
                                Style="{StaticResource HoverPlaybackButtonStyle}"
                                Width="48"
                                Height="48"
                                Padding="0"
                                FontSize="20"
                                Focusable="False"
                                IsEnabled="False"
                                Visibility="Collapsed"
                                Content="{Binding Content, ElementName=ToggleButton}"
                                AutomationProperties.Name="Play or pause"
                                Click="OnHoverPlaybackClick"/>
                    </Grid>
                </Border>

                <!-- Track metadata. The transparent border is the hover target
                     for the lyrics layout: it covers the whole text area, not
                     only the height of the text itself. -->
                <!-- #01FFFFFF instead of Transparent: this window is layered, and
                     the system hit-tests a layered window per pixel, so fully
                     transparent pixels never reach WPF. One step of alpha is
                     invisible but makes the whole text area hoverable. -->
                <Border x:Name="ContentArea"
                        Grid.Column="1"
                        Background="#01FFFFFF"
                        MouseEnter="OnContentMouseEnter"
                        MouseLeave="OnContentMouseLeave">
                <Grid x:Name="MetadataPanel"
                      Margin="8,0,10,0"
                      VerticalAlignment="Center"
                      ClipToBounds="True"
                      SizeChanged="OnMetadataSizeChanged">

                    <StackPanel x:Name="MetadataTextPanel" VerticalAlignment="Center">
                        <Canvas x:Name="TitleCanvas" Height="18" ClipToBounds="True">
                            <StackPanel x:Name="TitlePanel" Orientation="Horizontal">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="TitleTranslation"/>
                                </StackPanel.RenderTransform>
                                <TextBlock x:Name="TitlePrimary"
                                           Text="No media playing"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <Border x:Name="TitleSpacer" Width="32" Visibility="Collapsed"/>
                                <TextBlock x:Name="TitleSecondary"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Canvas>
                        <Canvas x:Name="ArtistCanvas" Height="16" ClipToBounds="True">
                            <StackPanel x:Name="ArtistPanel" Orientation="Horizontal">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ArtistTranslation"/>
                                </StackPanel.RenderTransform>
                                <TextBlock x:Name="ArtistPrimary"
                                           Text="Start playback in a media app"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"/>
                                <Border x:Name="ArtistSpacer" Width="32" Visibility="Collapsed"/>
                                <TextBlock x:Name="ArtistSecondary"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Canvas>
                    </StackPanel>

                    <Grid x:Name="LyricsPanel"
                          Height="38"
                          VerticalAlignment="Center"
                          ClipToBounds="True"
                          Visibility="Collapsed">
                        <Canvas x:Name="LyricsOriginalCanvas" Height="18" ClipToBounds="True"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LyricsOriginalText" Foreground="{DynamicResource TextPrimary}"
                                       FontWeight="SemiBold" FontSize="13"/>
                        </Canvas>
                        <Canvas x:Name="LyricsTranslationCanvas" Height="16" ClipToBounds="True"
                                VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock x:Name="LyricsTranslationText" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"/>
                        </Canvas>
                    </Grid>
                </Grid>
                </Border>

                <!-- Playback controls. The other layouts dock this strip in the
                     right column; the lyrics layout moves it over the text area,
                     where it drops down as a drawer with its own background. -->
                <Border x:Name="ControlsReveal"
                        Grid.Column="2"
                        ClipToBounds="True"
                        MouseEnter="OnContentMouseEnter"
                        MouseLeave="OnContentMouseLeave">
                    <Grid x:Name="DrawerLayout" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock x:Name="ProgressText"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="11"
                                       Visibility="Collapsed"/>
                            <StackPanel x:Name="PlaybackControls"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">

                            <Button x:Name="CopyButton"
                                    Style="{StaticResource TransportButton}"
                                    Width="24"
                                    Content="&#xE8C8;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="Copy the current lyric"
                                    Click="OnCopyClick"/>

                            <Button x:Name="TranslationButton"
                                    Style="{StaticResource TransportButton}"
                                    Width="24"
                                    Content="译"
                                    FontSize="11"
                                    Visibility="Collapsed"
                                    AutomationProperties.Name="Toggle translation"
                                    Click="OnTranslationClick"/>

                            <Button x:Name="LyricsButton"
                                    Style="{StaticResource TransportButton}"
                                    Width="24"
                                    Content="♫"
                                    FontSize="12"
                                    AutomationProperties.Name="Toggle lyrics"
                                    Click="OnLyricsClick"/>

                            <Button x:Name="PreviousButton"
                                    Style="{StaticResource TransportButton}"
                                    Width="22"
                                    Content="◂"
                                    AutomationProperties.Name="Previous track"
                                    Click="OnPreviousClick"
                                    IsEnabled="False"/>

                            <Button x:Name="ToggleButton"
                                    Style="{StaticResource PlayButton}"
                                    Width="30"
                                    Height="30"
                                    Content="▶"
                                    AutomationProperties.Name="Play or pause"
                                    Click="OnToggleClick"
                                    IsEnabled="False"/>

                            <Button x:Name="NextButton"
                                    Style="{StaticResource TransportButton}"
                                    Width="22"
                                    Content="▸"
                                    AutomationProperties.Name="Next track"
                                    Click="OnNextClick"
                                    IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- The hit area is taller than the 3 px bar so the bar is
                             comfortable to click; #01FFFFFF keeps it hit-testable
                             on a layered window. -->
                        <Border x:Name="ProgressHit"
                                Grid.Row="1"
                                Height="12"
                                Margin="0,2,0,0"
                                Background="#01FFFFFF"
                                Visibility="Collapsed"
                                MouseLeftButtonDown="OnProgressMouseDown"
                                MouseMove="OnProgressMouseMove"
                                MouseLeftButtonUp="OnProgressMouseUp"
                                LostMouseCapture="OnProgressLostCapture">
                            <Border x:Name="ProgressTrack"
                                    Height="3"
                                    VerticalAlignment="Center"
                                    CornerRadius="1.5"
                                    Background="{DynamicResource PlayOverlay}">
                                <Border x:Name="ProgressFill"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource Accent}"/>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
