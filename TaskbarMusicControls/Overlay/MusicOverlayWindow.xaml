<Window x:Class="TaskbarMusicControls.Overlay.MusicOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="350" Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#30343A"/>
            <Setter Property="Background" Value="#01000000"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#18000000"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#28000000"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton"
               TargetType="Button"
               BasedOn="{StaticResource TransportButton}">
            <Setter Property="Foreground" Value="#167C69"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <Style x:Key="HoverPlaybackButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#44000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#66000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Padding="0">

        <Border.ContextMenu>
            <ContextMenu Closed="OnContextMenuClosed">
                <MenuItem Header="Full layout"
                          Tag="FullDetails"
                          IsCheckable="True"
                          IsChecked="True"
                          Click="OnDisplayModeClick"/>
                <MenuItem Header="Cover and controls"
                          Tag="CoverAndControls"
                          IsCheckable="True"
                          Click="OnDisplayModeClick"/>
                <MenuItem Header="Cover only (hover to play/pause)"
                          Tag="CoverOnly"
                          IsCheckable="True"
                          Click="OnDisplayModeClick"/>
                <MenuItem Header="Lyric source">
                    <MenuItem Header="Automatic (local, NetEase, LRCLIB)"
                              Tag="Automatic" Click="OnLyricsSourceClick"/>
                    <MenuItem Header="NetEase Music"
                              Tag="Netease" Click="OnLyricsSourceClick"/>
                    <MenuItem Header="LRCLIB"
                              Tag="Lrclib" Click="OnLyricsSourceClick"/>
                </MenuItem>
                <MenuItem Header="Lyric timing (this song)">
                    <MenuItem Header="No adjustment" Tag="0" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Advance 0.2 s" Tag="-200" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Advance 0.5 s" Tag="-500" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Advance 1 s" Tag="-1000" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Advance 2 s" Tag="-2000" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Delay 0.2 s" Tag="200" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Delay 0.5 s" Tag="500" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Delay 1 s" Tag="1000" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Delay 2 s" Tag="2000" Click="OnLyricsOffsetClick"/>
                    <MenuItem Header="Delay 6 s" Tag="6000" Click="OnLyricsOffsetClick"/>
                </MenuItem>
                <MenuItem x:Name="TaskbarMenu" Header="Taskbar"/>
                <Separator/>
                <MenuItem Header="Exit Taskbar Music Widget"
                          Click="OnExitClick"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <!-- Horizontal layout -->
            <Grid x:Name="HorizontalContent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ArtworkColumn" Width="50"/>
                    <ColumnDefinition x:Name="MetadataColumn" Width="*"/>
                    <ColumnDefinition x:Name="ControlsColumn" Width="112"/>
                </Grid.ColumnDefinitions>

                <!-- Album artwork -->
                <Border x:Name="Artwork"
                        Width="48"
                        Height="48"
                        VerticalAlignment="Center"
                        MouseEnter="OnArtworkMouseEnter"
                        MouseLeave="OnArtworkMouseLeave">

                    <Border.Background>
                        <SolidColorBrush Color="#26353D"/>
                    </Border.Background>

                    <Grid>
                        <TextBlock x:Name="ArtworkGlyph"
                                   Text="♫"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="28"
                                   Foreground="#267D6C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Image x:Name="ArtworkImage"
                               Stretch="UniformToFill"
                               Visibility="Collapsed"/>

                        <Button x:Name="HoverPlaybackButton"
                                Style="{StaticResource HoverPlaybackButtonStyle}"
                                Width="48"
                                Height="48"
                                Padding="0"
                                FontSize="20"
                                Focusable="False"
                                IsEnabled="False"
                                Visibility="Collapsed"
                                Content="{Binding Content, ElementName=ToggleButton}"
                                AutomationProperties.Name="Play or pause"
                                Click="OnHoverPlaybackClick"/>
                    </Grid>
                </Border>

                <!-- Track metadata -->
                <Grid x:Name="MetadataPanel"
                      Grid.Column="1"
                      Margin="8,0,10,0"
                      VerticalAlignment="Center"
                      ClipToBounds="True"
                      SizeChanged="OnMetadataSizeChanged">

                    <StackPanel x:Name="MetadataTextPanel" VerticalAlignment="Center">
                        <Canvas x:Name="TitleCanvas" Height="18" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="TitleTranslation"/>
                                </StackPanel.RenderTransform>
                                <TextBlock x:Name="TitlePrimary"
                                           Text="No media playing"
                                           Foreground="#202124"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <Border x:Name="TitleSpacer" Width="32" Visibility="Collapsed"/>
                                <TextBlock x:Name="TitleSecondary"
                                           Foreground="#202124"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Canvas>
                        <Canvas x:Name="ArtistCanvas" Height="16" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform x:Name="ArtistTranslation"/>
                                </StackPanel.RenderTransform>
                                <TextBlock x:Name="ArtistPrimary"
                                           Text="Start playback in a media app"
                                           Foreground="#50545A"
                                           FontSize="11"/>
                                <Border x:Name="ArtistSpacer" Width="32" Visibility="Collapsed"/>
                                <TextBlock x:Name="ArtistSecondary"
                                           Foreground="#50545A"
                                           FontSize="11"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Canvas>
                    </StackPanel>

                    <Grid x:Name="LyricsPanel"
                          Height="38"
                          VerticalAlignment="Center"
                          ClipToBounds="True"
                          Visibility="Collapsed">
                        <Canvas x:Name="LyricsOriginalCanvas" Height="18" ClipToBounds="True"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="LyricsOriginalText" Foreground="#202124"
                                       FontWeight="SemiBold" FontSize="13"/>
                        </Canvas>
                        <Canvas x:Name="LyricsTranslationCanvas" Height="16" ClipToBounds="True"
                                VerticalAlignment="Bottom" Visibility="Collapsed">
                            <TextBlock x:Name="LyricsTranslationText" Foreground="#50545A"
                                       FontSize="11"/>
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- Playback controls -->
                <StackPanel x:Name="PlaybackControls"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="LyricsButton"
                            Style="{StaticResource TransportButton}"
                            Width="24"
                            Content="♫"
                            FontSize="12"
                            AutomationProperties.Name="Toggle lyrics"
                            Click="OnLyricsClick"/>

                    <Button x:Name="PreviousButton"
                            Style="{StaticResource TransportButton}"
                            Width="22"
                            Content="◂"
                            AutomationProperties.Name="Previous track"
                            Click="OnPreviousClick"
                            IsEnabled="False"/>

                    <Button x:Name="ToggleButton"
                            Style="{StaticResource PlayButton}"
                            Width="30"
                            Height="30"
                            Content="▶"
                            AutomationProperties.Name="Play or pause"
                            Click="OnToggleClick"
                            IsEnabled="False"/>

                    <Button x:Name="NextButton"
                            Style="{StaticResource TransportButton}"
                            Width="22"
                            Content="▸"
                            AutomationProperties.Name="Next track"
                            Click="OnNextClick"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
